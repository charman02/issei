{
  "family": "IsseiStackTaskDefC777D49A",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::069091212126:role/IsseiStack-TaskDefExecutionRoleB4775C97-NoiDJjteQkNs",
  "taskRoleArn": "arn:aws:iam::069091212126:role/IsseiStack-TaskDefTaskRole1EDB4A67-G6o9eTm62JQh",
  "containerDefinitions": [
    {
      "name": "issei-api",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/DATABASE_URL"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/JWT_SECRET"
        },
        {
          "name": "CLOUDINARY_CLOUD_NAME",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/CLOUDINARY_CLOUD_NAME"
        },
        {
          "name": "CLOUDINARY_API_KEY",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/CLOUDINARY_API_KEY"
        },
        {
          "name": "CLOUDINARY_API_SECRET",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/CLOUDINARY_API_SECRET"
        },
        {
          "name": "OPENROUTER_API_KEY",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/OPENROUTER_API_KEY"
        },
        {
          "name": "VAPID_PRIVATE_KEY",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/VAPID_PRIVATE_KEY"
        },
        {
          "name": "VAPID_PUBLIC_KEY",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/VAPID_PUBLIC_KEY"
        },
        {
          "name": "VAPID_SUBJECT",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/VAPID_SUBJECT"
        },
        {
          "name": "CRON_SECRET",
          "valueFrom": "arn:aws:ssm:us-west-2:069091212126:parameter/issei/CRON_SECRET"
        }
      ],
      "environment": [
        {
          "name": "OPENROUTER_REFERER",
          "value": "https://issei.app"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "https://issei.app,https://www.issei.app,https://issei-delta.vercel.app"
        },
        {
          "name": "SENDER_EMAIL",
          "value": "noreply@issei.app"
        },
        {
          "name": "APP_URL",
          "value": "https://issei.app"
        },
        {
          "name": "PROMPT_SCHEDULER_INTERVAL_SECONDS",
          "value": "600"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=2).status==200 else 1)\""],
        "interval": 30,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/issei-api",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
