# Required
DATABASE_URL=sqlite:///./recipes.db
JWT_SECRET=change-me

# Photo uploads (optional — the add form's photo box needs these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Extra allowed frontend origins, comma-separated. localhost:5173 and the deployed
# frontend are always allowed, so this is only for an additional frontend host.
CORS_ORIGINS=

# OpenRouter — structures a spoken or pasted recipe into fields (POST /recipes/parse).
#
# OPTIONAL. With no key the endpoint returns ai=false and the frontend falls back to its
# own line-based parser, so /add works exactly as it did before this existed. That is the
# whole point of the fallback: this feature must not be able to break recipe capture.
#
# Server-side only — never a VITE_ variable. Vite inlines those into the bundle, which is
# public at /assets/index-*.js, so a key there could be read and used to spend credits.
OPENROUTER_API_KEY=
# Defaults to deepseek/deepseek-v4-flash-0731. Cheap and fast is right for bounded
# extraction against a fixed schema; a frontier model would buy nothing a user could
# perceive. (Sent with reasoning disabled — see recipe_ai.py.)
OPENROUTER_MODEL=
# Optional, for attribution on the OpenRouter dashboard.
OPENROUTER_REFERER=

# Password-reset email (app/services/email.py). SENDER_EMAIL must be a VERIFIED SES identity
# in us-west-2 or sending fails; APP_URL is the site the emailed reset link points at, so it
# must be the canonical origin, never a deploy alias.
SENDER_EMAIL=noreply@example.com
APP_URL=http://localhost:5173

# Where a new in-app feedback note gets emailed (#101). OPTIONAL, and unset is fine: it falls
# back to SENDER_EMAIL, which needs no new secret because SES requires the sender to be verified
# and — inside the SES sandbox — the recipient too, so the one address certain to be verified is
# the one above. Point this at a real inbox once that address is verified in SES.
#
# Both empty → no email at all, logged once per note, and the feedback still saves. Unconfigured
# means off, never broken, exactly as with the VAPID keys below.
#
# To read the notes already in the table (rather than waiting for the next one):
#   DATABASE_URL="postgresql://..." python scripts/read_feedback.py
FEEDBACK_NOTIFY_EMAIL=

# --- The in-process daily-prompt ticker (2026-09-18) — OPTIONAL ---
# How often the app itself runs the daily-prompt pass, in seconds. Default 600.
#
# It exists because GitHub Actions caps `daily-prompt.yml` at 5-7 runs a day no matter what the cron
# asks for — raising the declared frequency from hourly to every 10 minutes delivered the same
# number of runs — five complete days of hourly against one of every-ten-minutes, both a mean of
# 6.0/day — against a send window only four hours wide. The Actions
# cron stays on as a SECOND trigger; both are idempotent per (user, local_date) via `prompt_sends`'
# UNIQUE, so they cannot double-send.
#
# SET IT TO 0 TO DISABLE — 0, not blank. What that actually buys you, stated precisely,
# because the first version of this note overclaimed it: the variable IS now in
# `.aws/task-definition.json`, and a hand-registered revision with 0
# stops the loop only once the SERVICE is pointed at it — `aws ecs update-service --task-definition <family>:<rev> --force-new-deployment`. The service holds a concrete revision ARN, so registering alone leaves new tasks launching the old one; `infra/RUNBOOK.md` states that mechanic correctly for the `cdk deploy` hazard and the first version of this note dropped half of it. And it self-reverts: the pipeline renders every revision from the committed JSON, so the next merge to main restores 600. Emergency stop, not a durable setting — for durable, edit `.aws/task-definition.json` and ship it. (Blank used to crash Settings at import and take the container down with
# it — fixed, and pinned by a test, because clearing a field is the instinctive way to switch
# something off.)
#
# FLOORED AT 600s internally (`prompt_scheduler.MIN_INTERVAL_SECONDS`), and the floor is a COST
# boundary, not protection against a hot loop: a successful tick refreshes the /health/ready cache,
# so this loop is the only thing querying the database periodically and the interval IS the idle
# window Neon gets. A smaller value is clamped UP and logged at WARNING — setting 120 here does NOT
# give you a 120s send window, it gives you 600 and a warning.
# FORGIVING VALUES, because the whole point of this field is that someone reaches for it in a hurry:
#   0 / off / false / no / none / disabled / disable  -> disabled
#   on / true / yes / enable / enabled / default      -> the default interval
#   blank                                             -> the default interval (means "unset")
# Anything else unparseable still RAISES at import, deliberately — `600s` or `ten` is a typo to fix,
# not an intention to infer. Both word lists exist because before them `off` AND `on` each crashed
# the API container and the migration task, on the field every doc calls the emergency stop.
PROMPT_SCHEDULER_INTERVAL_SECONDS=600

# --- Push notifications (#89) — ALL OPTIONAL ---
# Leave every one of these blank and notifications are simply OFF: `services/push.is_configured()`
# returns False, each send is a logged no-op, and POST /notifications/run-daily-prompt answers 404.
# Nothing else in the app changes. See infra/RUNBOOK.md "Step 1b" for generating a keypair and for
# the ordering that matters (SSM parameters BEFORE the task-definition entries, or ECS can't start
# the task).
#
# A P-256 ECDSA keypair, base64url. The PUBLIC half is not a secret — it is served to every browser
# by GET /notifications/vapid-key, because a client needs it to subscribe at all.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# A mailto: or https: URL a push service can contact about our sends. Required by RFC 8292 whenever
# a key is set; has a sane default in config.py.
VAPID_SUBJECT=
# The shared secret the daily-prompt cron presents in an X-Issei-Cron-Key header. That cron is the
# SECOND trigger; the primary one is in-process and needs no secret because it makes no HTTP call.
# The cron asks for every 10 minutes and GitHub delivers 5-7 runs a day whatever it asks — a cap,
# not a loss rate — against a send window only four hours wide. UNSET
# DISABLES the route rather than leaving it open — see the note in app/config.py.
CRON_SECRET=
