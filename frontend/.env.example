# Frontend environment variables (Vite). Copy to .env for local dev, or set in
# your host's dashboard (e.g. Vercel) for production.

# Base URL of the backend API. Defaults to http://localhost:8000 if unset.
#
# Since #89 this value also travels INTO the service worker, as a query string on its
# registration (`/sw.js?api=...`), because a worker can't read import.meta.env and files in
# public/ are copied verbatim. Two consequences: no trailing slash is needed (the worker strips
# them anyway), and changing this value changes the worker's script URL — which the browser
# correctly treats as a new worker and re-registers. Nothing to do about it; just don't be
# surprised.
VITE_API_URL=http://localhost:8000

# Optional: the build identifier sent along with in-app feedback, so a report can
# be matched to the deploy the sender was actually running. Set it in your host's
# dashboard to something you can trace (a date or a commit SHA). Left unset,
# feedback is stored with no version rather than a made-up one.
VITE_APP_VERSION=

# VITE_FEEDBACK_URL was removed: "Send feedback" on the You page now opens an
# in-app form that stores notes via POST /feedback, instead of an external hosted
# form. If it is still set on a deploy host, it is unused and can be deleted.
